---
import { Image } from "astro:assets";
import Facebook from "../assets/facebook.svg";
import Instagram from "../assets/instagram.svg";
import LinkedIn from "../assets/linkedin.svg";
import logo from "../assets/logo.png";
import Mail from "../assets/mail.svg";
import type { ContactLink } from "../types";

const contactLink: ContactLink[] = [
  { tag: Mail, label: "Email", link: "mailto:triton.rov1@gmail.com" },
  {
    tag: Facebook,
    label: "Facebook",
    link: "https://www.facebook.com/triton.rov",
  },
  {
    tag: Instagram,
    label: "Instagram",
    link: "https://www.instagram.com/triton.rov",
  },
  {
    tag: LinkedIn,
    label: "LinkedIn",
    link: "https://www.linkedin.com/company/triton-rov/",
  },
];
---

<footer class="contact" data-contact-footer>
  <h2 class="contact-title">Contact Us</h2>
  <ul class="contact-links" aria-label="Contact links">
    {
      contactLink.map((link) => {
        const Tag = link.tag;
        return (
          <li>
            <a
              class="contact-link"
              href={link.link}
              aria-label={`Triton's ${link.label}`}
            >
              <Tag
                class="contact-icon"
                aria-hidden="true"
                width="20"
                height="20"
                fill="currentColor"
              />
            </a>
          </li>
        );
      })
    }
  </ul>

  <div class="contact-brand">
    <Image
      class="contact-logo"
      src={logo}
      width={88}
      height={50}
      alt="Triton's logo"
    />
    <small>© 2026 | Triton</small>
  </div>
</footer>

<div class="safari-bottom-bleed" aria-hidden="true"></div>

<script>
  const setupSafariBottomBleed = () => {
    const contact = document.querySelector<HTMLElement>(
      "[data-contact-footer]",
    );
    const bleed = document.querySelector<HTMLElement>(".safari-bottom-bleed");

    if (!contact || !bleed) return;

    const observer = new IntersectionObserver(
      ([entry]) => {
        bleed.classList.toggle("is-active", entry.isIntersecting);
      },
      { threshold: 0 },
    );

    observer.observe(contact);
  };

  document.addEventListener("astro:page-load", setupSafariBottomBleed);
</script>

<style>
  .contact {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    background: var(--navy);
    padding: 0.3rem 0.3rem max(0.3rem, env(safe-area-inset-bottom, 0px));
  }

  .contact::before {
    content: "";
    position: absolute;
    right: 0;
    bottom: 100%;
    left: 0;
    height: 34rem;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--navy) 0%, transparent) 0%,
      color-mix(in srgb, var(--navy) 1%, transparent) 6%,
      color-mix(in srgb, var(--navy) 2%, transparent) 12%,
      color-mix(in srgb, var(--navy) 4%, transparent) 18%,
      color-mix(in srgb, var(--navy) 6%, transparent) 24%,
      color-mix(in srgb, var(--navy) 9%, transparent) 30%,
      color-mix(in srgb, var(--navy) 12%, transparent) 36%,
      color-mix(in srgb, var(--navy) 16%, transparent) 42%,
      color-mix(in srgb, var(--navy) 21%, transparent) 48%,
      color-mix(in srgb, var(--navy) 28%, transparent) 54%,
      color-mix(in srgb, var(--navy) 36%, transparent) 60%,
      color-mix(in srgb, var(--navy) 45%, transparent) 66%,
      color-mix(in srgb, var(--navy) 55%, transparent) 72%,
      color-mix(in srgb, var(--navy) 66%, transparent) 78%,
      color-mix(in srgb, var(--navy) 78%, transparent) 84%,
      color-mix(in srgb, var(--navy) 90%, transparent) 92%,
      var(--navy) 100%
    );
  }

  .safari-bottom-bleed {
    display: none;
  }

  @supports (-webkit-touch-callout: none) {
    @media (width < 48rem) {
      .safari-bottom-bleed.is-active {
        position: fixed;
        z-index: 9;
        right: 0;
        bottom: -8px;
        left: 0;
        display: block;
        height: 16px;
        background-color: var(--navy);
        pointer-events: none;
      }
    }
  }

  .contact-title {
    padding-left: 1rem;
    font-family: var(--font-special-gothic-expanded-one), sans-serif;
    font-size: 1.05rem;
    letter-spacing: 0.05em;
    color: var(--blue);
    text-transform: uppercase;
    line-height: 1;
  }

  .contact-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contact-link {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    color: var(--blue);
  }

  .contact-icon {
    transition: transform 250ms ease;
  }

  .contact-icon:hover {
    transform: scale(1.2);
  }

  .contact-brand {
    display: flex;
    align-items: end;
    justify-self: end;
    flex-direction: column;
    gap: 0.25rem;
  }

  .contact-logo {
    width: 5.5rem;
    filter: brightness(0) invert(1);
  }

  .contact-brand small {
    color: color-mix(in srgb, var(--white) 52%, transparent);
    font-family: sans-serif;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }

  @media (width < 48rem),
    (min-width: 48rem) and (max-width: 64rem) and (orientation: portrait) {
    .contact {
      gap: 0.375rem;
      padding: 0.2rem 0.2rem max(0.2rem, env(safe-area-inset-bottom, 0px));
    }

    .contact-title {
      padding-left: 0.2rem;
      font-size: 0.65rem;
      letter-spacing: 0.01em;
      white-space: nowrap;
    }

    .contact-links {
      gap: 0;
    }

    .contact-link {
      width: 2.25rem;
      height: 2.25rem;
    }

    .contact-icon {
      width: 1rem;
      height: 1rem;
    }

    .contact-brand {
      gap: 0.1rem;
    }

    .contact-logo {
      width: auto;
      height: 1.5rem;
    }

    .contact-brand small {
      font-size: 0.625rem;
      letter-spacing: 0.03em;
    }
  }
</style>
