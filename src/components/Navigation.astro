---
import { Image } from "astro:assets";
import type { Link } from "../types";
import tritonLogo from "../assets/logo.png";
import universityLogo from "../assets/uni-logo.png";

const navigation: Link[] = [
  { label: "Home", link: "/" },
  { label: "Members", link: "/members/" },
  { label: "Docs", link: "https://docs.aastmt-triton.com/" },
];
---

<nav class="navigation" aria-label="Primary navigation">
  <Image
    class="navigation-corner"
    id="triton"
    src={tritonLogo}
    width={80}
    height={45}
    alt="Triton"
    priority
  />

  {
    navigation.map((item) => {
      return (
        <a class="navigation-link" href={item.link}>
          {item.label}
        </a>
      );
    })
  }

  <Image
    class="navigation-corner"
    id="university"
    src={universityLogo}
    width={40}
    height={40}
    alt="Arab Academy for Science, Technology and Maritime Transport"
    priority
  />
</nav>

<style>
  .navigation {
    position: fixed;
    z-index: 20;
    top: 0;
    right: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 1rem 1.5rem;
    background: transparent;
  }

  .navigation::before {
    position: absolute;
    z-index: -1;
    top: -1;
    right: 0;
    left: 0;
    height: calc(100% + 3em);
    background: color-mix(in srgb, var(--white) 9%, transparent);
    content: "";
    pointer-events: auto;
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    -webkit-mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 35%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 35%,
      transparent 100%
    );
  }

  .navigation-corner {
    position: absolute;
    z-index: 1;
    top: 50%;
    display: block;
    transform: translateY(-50%);
    object-fit: contain;
  }

  #triton {
    left: 0.2rem;
  }

  #university {
    right: 1.2rem;
  }

  .navigation-link {
    padding: 0.45rem 0.65rem;
    border-radius: 0.35rem;
    color: var(--navy);
    font-family: var(--font-special-gothic-expanded-one), sans-serif;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 180ms ease,
      box-shadow 180ms ease,
      color 180ms ease;
  }

  .navigation-link:hover {
    background: var(--white);
    box-shadow: 0 0.25rem 0.75rem
      color-mix(in srgb, var(--navy) 12%, transparent);
    color: var(--blue);
  }

  @media (width < 48rem),
    (min-width: 48rem) and (max-width: 64rem) and (orientation: portrait) {
    .navigation {
      gap: 0.75rem;
      padding: 0.75rem 1rem;
    }

    .navigation-corner {
      display: none;
    }
  }
</style>
