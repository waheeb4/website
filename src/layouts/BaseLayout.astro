---
import BaseHead from "../components/BaseHead.astro";
import type { Metadata } from "../types";

interface Props {
  metadata: Metadata;
}

const { metadata } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <BaseHead {metadata} />
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
