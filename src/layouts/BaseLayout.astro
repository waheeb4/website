---
import { Font } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Navigation from "../components/Navigation.astro";
import ContactInfo from "../components/ContactInfo.astro";
import "../styles/global.css";
import type { Metadata } from "../types";

interface Props {
  metadata: Metadata;
}

const { metadata } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <Font cssVariable="--font-special-gothic-expanded-one" preload />
    <Font cssVariable="--font-plus-jakarta-sans" preload />
    <Font cssVariable="--font-cormorant-garamond" preload />
    <Font cssVariable="--font-dm-serif-display" preload />
    <BaseHead {metadata} />
  </head>
  <body>
    <Navigation />
    <main>
      <slot />
    </main>
    <ContactInfo />
  </body>
</html>
