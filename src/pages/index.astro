---
import BaseLayout from "../layouts/BaseLayout.astro";
import About from "../components/idx/About.astro";
import Hero from "../components/idx/Hero.astro";
import Achievements from "../components/idx/Achievements.astro";
import Shadow from "../components/idx/Shadow.astro";
import type { Metadata } from "../types";

const metadata: Metadata = {
  title: "Triton | Home",
  description:
    "A student-led engineering team building underwater Remotely Operated Vehicles",
  og: {
    image: "/og.png",
    alt: "Triton x AASTMT preview image",
    type: "website",
  },
};
---

<BaseLayout {metadata}>
  <Hero />
  <About />
  <Achievements />
  <Shadow />
</BaseLayout>
